{
  "name": "eslint-yaml",
  "version": "0.0.1",
  "description": "YAML capabilities for ESLint",
  "files": [
    "lib"
  ],
  "keywords": [
    "yaml",
    "eslint",
    "eslint-yaml",
    "lint"
  ],
  "homepage": "https://github.com/43081j/eslint-yaml#readme",
  "bugs": {
    "url": "https://github.com/43081j/eslint-yaml/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/43081j/eslint-yaml.git"
  },
  "license": "MIT",
  "author": "James Garbutt (https://github.com/43081j)",
  "type": "module",
  "main": "lib/main.js",
  "scripts": {
    "clean": "premove lib",
    "build": "npm run clean && tsc",
    "format": "prettier --write src test",
    "lint:js": "eslint src test",
    "lint:format": "prettier --check src test",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "lint": "npm run lint:js && npm run lint:format && npm run typecheck:tests",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@humanwhocodes/momoa": "^3.3.10",
    "@vitest/coverage-v8": "^4.0.3",
    "eslint": "^9.38.0",
    "eslint-plugin-eslint-plugin": "^7.2.0",
    "premove": "^4.0.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^4.0.3"
  },
  "dependencies": {
    "@eslint/core": "^0.15.2",
    "@eslint/plugin-kit": "^0.3.5",
    "yaml": "^2.8.1"
  }
}
